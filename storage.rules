rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /campaign-images/{uid}/{fileName} {
      // As imagens aparecem nos relatórios compartilhados.
      allow read: if true;

      // Somente o navegador autenticado que criou a campanha pode enviar ou substituir imagens.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // O mesmo proprietário pode remover a imagem ao excluir a campanha.
      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
